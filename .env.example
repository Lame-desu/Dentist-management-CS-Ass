# ╔══════════════════════════════════════════════════╗
# ║   DAMS — Environment Variables                   ║
# ║   Copy this file to .env and update values        ║
# ╚══════════════════════════════════════════════════╝

# ── Database (PostgreSQL 16) ──────────────────────
POSTGRES_DB=dams
POSTGRES_USER=dams_user
POSTGRES_PASSWORD=dams_password          # ⚠ Change in production!

# ── Backend (Express.js API) ─────────────────────
DATABASE_URL=postgresql://dams_user:dams_password@db:5432/dams
JWT_SECRET=dams-jwt-secret-change-in-production   # ⚠ Change in production!
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=5000

# ── Seed Database ────────────────────────────────
# Set to "true" to seed demo data on startup.
# Only use in development! Set to "false" or remove in production.
SEED_DB=true

# ── Frontend (Next.js) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
