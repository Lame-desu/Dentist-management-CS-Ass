# ═══════════════════════════════════════════════════════════════
# Force LF line endings for all platforms (Linux, Windows, macOS)
# Prevents CRLF issues that break shell scripts inside Docker
# ═══════════════════════════════════════════════════════════════

# Default: auto-detect text files, normalize to LF in repo
* text=auto eol=lf

# ── Shell scripts — MUST be LF (critical for Docker) ─────────
*.sh text eol=lf

# ── Docker files ─────────────────────────────────────────────
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# ── Config files ─────────────────────────────────────────────
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.env* text eol=lf

# ── Binary files — do NOT modify ─────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
